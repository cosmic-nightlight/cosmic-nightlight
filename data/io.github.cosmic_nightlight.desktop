[Desktop Entry]
# The applet's desktop entry under the app ID it had before 0.7.0. Not for the
# flatpak, which can only export entries named after its own ID.
#
# cosmic-panel starts an applet by looking up the entry its config names, and a
# panel set up before the upgrade still names this one. Without it the applet
# would silently leave the panel. With it the applet starts, renames its panel
# entry to the new ID (config::adopt_panel_entry), and is restarted from the
# real entry. Drop this file once upgrades from 0.6 no longer matter.
#
# There is no X-CosmicApplet key on purpose. cosmic-panel does not need it, and
# COSMIC Settings lists only entries that have it, so the applet picker shows
# Night Light once.
Type=Application
Name=Night Light
Exec=cosmic-ext-nightlight --applet
Icon=io.github.cosmic_ext_nightlight
Terminal=false
NoDisplay=true
