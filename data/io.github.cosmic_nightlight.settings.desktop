[Desktop Entry]
# Translations go in this file, not in the Fluent catalogs: the desktop and the
# software centers read this entry directly, before anything of ours has run.
# Add a suffixed line beside each of Name, GenericName, Comment and Keywords —
# `Name[de]=...` — and leave the unsuffixed lines as the English fallback. See
# docs/translating.md.
Type=Application
Name=Night Light Settings
GenericName=Color Temperature Settings
Comment=Configure the schedule, color temperature, and brightness
Exec=cosmic-nightlight --settings
Icon=io.github.cosmic_nightlight
Terminal=false
Categories=Utility;Settings;DesktopSettings;
Keywords=night;light;shift;redshift;gamma;color;temperature;blue;warm;schedule;
StartupNotify=true
# Matches the id the settings window reports (config::SETTINGS_APP_ID), which is
# this file's own desktop id rather than the applet's. The applet's entry is
# NoDisplay, so a window claiming that id gets no icon in the dock.
StartupWMClass=io.github.cosmic_nightlight.settings
