// SPDX-License-Identifier: MPL-2.0
//
// Allows members of the "wheel" or "sudo" group to run the
// cosmic-ext-nightlight privileged helper via pkexec without re-entering
// their password each time the tint changes.
//
// pkexec authorizes program launches through the generic
// "org.freedesktop.policykit.exec" action; action.lookup("program")
// returns the canonical path of the program being run. Fedora Atomic redirects
// /usr/local to /var/usrlocal, so allow that root-owned location as well.
//
// Install to /etc/polkit-1/rules.d/ (see scripts/install.sh).
//
// The app mirrors the group list in PASSWORDLESS_GROUPS (backend.rs) so it can
// tell when a change would prompt. Keep the two in step.

polkit.addRule(function (action, subject) {
    var program = action.lookup("program");
    var is_helper =
        program == "/usr/bin/cosmic-ext-nightlight-helper" ||
        program == "/usr/local/bin/cosmic-ext-nightlight-helper" ||
        program == "/var/usrlocal/bin/cosmic-ext-nightlight-helper" ||
        // The helper's name before 0.7.0, which the .deb, .rpm and Arch
        // packages ship as a link to the new one. An applet started before the
        // upgrade keeps calling it until the next login. pkexec reports the
        // path it was given, not where a link points, so the old name needs
        // its own entry or that applet asks for a password on every change.
        // Drop it together with the link.
        program == "/usr/bin/cosmic-nightlight-helper";
    if (
        action.id == "org.freedesktop.policykit.exec" &&
        // Only as root, which the helper needs anyway. pkexec --user would
        // otherwise run it as anyone without a password.
        action.lookup("user") == "root" &&
        is_helper &&
        (subject.isInGroup("wheel") || subject.isInGroup("sudo"))
    ) {
        return polkit.Result.YES;
    }
});
